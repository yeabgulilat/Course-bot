# Copy this file to ".env" and fill in real values. NEVER commit .env.

# Token from @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Telegram user IDs allowed to approve/reject. Separate several with commas.
ADMIN_IDS=123456789

# Chat where payment proofs are sent. Your own user ID works (you must press Start on the bot first).
ADMIN_CHAT_ID=123456789

# Private course channel ID. It looks like -1001234567890
CHANNEL_ID=-1001234567890

# Neon PostgreSQL connection string
DATABASE_URL=PASTE_YOUR_NEON_CONNECTION_STRING_HERE

# Random secret so only Telegram can call your webhook (used on Render)
WEBHOOK_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE